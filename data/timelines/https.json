    "captions": [
        {
            "t": 0,
            "text": "এটা কোনো ভিডিও নয়, সাধারণ HTML। আজ আমরা দেখব, HTTPS কীভাবে কাজ করে।"
        },
        {
            "t": 6.7,
            "text": "সাধারণ HTTP-তে ডেটা যায় খোলা লেখা হিসেবে।"
        },
        {
            "t": 10.4,
            "text": "ফলে মাঝপথে কেউ আড়ি পাতলে সে সবকিছু পড়তে পারে। আপনার পাসওয়ার্ডও তার চোখে পড়ে যায়।"
        },
        {
            "t": 17,
            "text": "HTTPS শুরু হয় একটা হ্যান্ডশেক দিয়ে।"
        },
        {
            "t": 20,
            "text": "ব্রাউজার জানায়, সে কোন TLS সংস্করণ আর কোন এনক্রিপশন পদ্ধতি বোঝে।"
        },
        {
            "t": 25.4,
            "text": "সার্ভার একটা পদ্ধতি বেছে নেয়, আর নিজের সার্টিফিকেট পাঠায়।"
        },
        {
            "t": 29.3,
            "text": "ব্রাউজার যাচাই করে, সার্টিফিকেটটা বিশ্বস্ত কর্তৃপক্ষের স্বাক্ষর করা এবং এই ডোমেইনেরই।"
        },
        {
            "t": 35.3,
            "text": "দুই পক্ষ কী-শেয়ার বিনিময় করে একই সেশন কী হিসাব করে নেয়। কী-টা নিজে কখনো নেটওয়ার্কে যায় না, তাই চুরিও হয় না।"
        },
        {
            "t": 43.1,
            "text": "এখন সব ডেটা এনক্রিপ্ট হয়ে যায়।"
        },
        {
            "t": 45.5,
            "text": "আড়ি পাতা লোকটা এখন শুধু অর্থহীন অক্ষর দেখে। সেশন কী ছাড়া এর মানে বের করা কার্যত সম্ভব নয়।"
        },
        {
            "t": 52.7,
            "text": "সংক্ষেপে, HTTPS তিনটা জিনিস দেয়: গোপনীয়তা, পরিচয় যাচাই, আর ডেটার অখণ্ডতা।"
        }
    ]
}
