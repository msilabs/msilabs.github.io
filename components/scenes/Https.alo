<!-- দৃশ্য: প্রতিটা এলিমেন্টের data-at = কখন আসবে, data-until = কখন যাবে (অডিওর সেকেন্ডে)।
     সব সময় আসে data/timelines/https.json থেকে। -->
<template>
    <div class="scene">
        <div class="cue title" data-at="0" data-until="{{ props.timeline.titleUntil }}">
            <b>{{ props.timeline.title }}</b>
            <span>{{ props.timeline.subtitle }}</span>
        </div>

        <template for="l in props.timeline.labels">
            <div class="cue label {{ l.tone }}" data-at="{{ l.at }}" data-until="{{ l.until }}">{{ l.text }}</div>
        </template>

        <div class="cue wire" data-at="{{ props.timeline.actors.at }}" data-until="{{ props.timeline.actors.until }}"></div>
        <div class="cue actor browser" data-at="{{ props.timeline.actors.at }}" data-until="{{ props.timeline.actors.until }}">
            <i>💻</i><b>ব্রাউজার</b>
        </div>
        <div class="cue actor server" data-at="{{ props.timeline.actors.at }}" data-until="{{ props.timeline.actors.until }}">
            <i>🗄️</i><b>সার্ভার</b>
        </div>
        <div class="cue tap" data-at="{{ props.timeline.actors.hackerAt }}" data-until="{{ props.timeline.actors.until }}"></div>
        <div class="cue actor hacker" data-at="{{ props.timeline.actors.hackerAt }}" data-until="{{ props.timeline.actors.until }}">
            <i>🕵️</i><b>আড়ি পাতা লোক</b>
        </div>

        <template for="p in props.timeline.packets">
            <div class="pkt {{ p.kind }} {{ p.dir }}" data-at="{{ p.at }}" data-until="{{ p.until }}">{{ p.text }}</div>
        </template>

        <template for="b in props.timeline.bubbles">
            <div class="cue bubble {{ b.mono ? 'mono' : '' }}" data-at="{{ b.at }}" data-until="{{ b.until }}">{{ b.text }}</div>
        </template>

        <div class="cue cert" data-at="{{ props.timeline.cert.at }}" data-until="{{ props.timeline.cert.until }}">
            <b>{{ props.timeline.cert.title }}</b><br>{{ props.timeline.cert.text }}
        </div>

        <div class="cue key l" data-at="{{ props.timeline.keys.leftAt }}" data-until="{{ props.timeline.keys.until }}">{{ props.timeline.keys.text }}</div>
        <div class="cue key r" data-at="{{ props.timeline.keys.rightAt }}" data-until="{{ props.timeline.keys.until }}">{{ props.timeline.keys.text }}</div>

        <div class="cards">
            <template for="c in props.timeline.cards">
                <div class="cue card" data-at="{{ c.at }}">
                    <i>{{ c.icon }}</i><b>{{ c.title }}</b><span>{{ c.text }}</span>
                </div>
            </template>
        </div>
    </div>
</template>

<style>
    .scene {
        position: absolute;
        inset: 0;
    }

    .scene > * {
        position: absolute;
    }

    /* সময় অনুযায়ী দেখা/লুকানো এলিমেন্ট: Player এগুলোতে .on বসায় আর সরায় */
    .cue {
        opacity: 0;
        transform: translateY(1.2cqw);
        transition: opacity 0.45s, transform 0.45s;
        pointer-events: none;
    }

    .cue.on {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }

    .title {
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .title b {
        font-size: 6cqw;
        line-height: 1.25;
    }

    .title span {
        font-size: 2.4cqw;
        color: var(--muted);
        margin-top: 1cqw;
    }

    .label {
        top: 6%;
        left: 50%;
        translate: -50% 0;
        white-space: nowrap;
        font-size: 2.6cqw;
        font-weight: 700;
        padding: 0.4cqw 1.6cqw;
        border-radius: 99px;
        background: var(--chip);
        border: 1px solid var(--line);
    }

    .label.bad {
        color: var(--danger);
    }

    .label.good {
        color: var(--ok);
    }

    .actor {
        width: 18%;
        padding: 1.4cqw 0.6cqw;
        text-align: center;
        border-radius: 1.2cqw;
        border: 0.25cqw solid var(--ink);
        background: var(--stage);
    }

    .actor i {
        display: block;
        font-style: normal;
        font-size: 4.4cqw;
        line-height: 1.1;
    }

    .actor b {
        font-size: 2cqw;
    }

    .browser {
        left: 6%;
        top: 36%;
    }

    .server {
        right: 6%;
        top: 36%;
    }

    .hacker {
        left: 41%;
        top: 61%;
        border-color: var(--danger);
        color: var(--danger);
    }

    .wire {
        left: 24%;
        right: 24%;
        top: 47.5%;
        height: 0.3cqw;
        background: var(--ink);
    }

    .tap {
        left: 50%;
        top: 48%;
        width: 0;
        height: 13%;
        border-left: 0.3cqw dashed var(--danger);
    }

    .pkt {
        top: 37.5%;
        left: 25%;
        width: 20%;
        text-align: center;
        opacity: 0;
        font-size: 1.7cqw;
        font-weight: 600;
        padding: 0.7cqw 0.5cqw;
        border-radius: 0.8cqw;
        background: var(--chip);
        border: 0.2cqw solid var(--accent);
        color: var(--ink);
        transition: opacity 0.3s, left 0s 0.3s;
    }

    .pkt.rev {
        left: 55%;
    }

    .pkt.on {
        opacity: 1;
        left: 55%;
        transition: opacity 0.3s, left 2.6s ease-in-out 0.2s;
    }

    .pkt.rev.on {
        left: 25%;
    }

    .pkt.plain {
        border-color: var(--danger);
    }

    .pkt.enc {
        border-color: var(--ok);
        font-family: ui-monospace, Menlo, Consolas, monospace;
    }

    .bubble {
        left: 61%;
        top: 64%;
        width: 30%;
        font-size: 1.7cqw;
        padding: 0.8cqw 1.2cqw;
        border-radius: 1cqw;
        border: 0.2cqw solid var(--danger);
        color: var(--danger);
        background: var(--stage);
    }

    .bubble.mono {
        font-family: ui-monospace, Menlo, Consolas, monospace;
    }

    .cert {
        left: 4%;
        top: 62%;
        width: 33%;
        font-size: 1.6cqw;
        padding: 0.8cqw 1.2cqw;
        border-radius: 1cqw;
        border: 0.2cqw solid var(--ok);
        background: var(--stage);
    }

    .cert b {
        color: var(--ok);
    }

    .key {
        top: 24%;
        width: 18%;
        text-align: center;
        font-size: 1.9cqw;
        font-weight: 700;
        color: var(--ok);
    }

    .key.l {
        left: 6%;
    }

    .key.r {
        right: 6%;
    }

    .cards {
        inset: 20% 5% 22%;
        display: flex;
        gap: 2.4cqw;
        align-items: stretch;
        pointer-events: none;
    }

    .card {
        flex: 1;
        padding: 2cqw 1.6cqw;
        border-radius: 1.2cqw;
        text-align: center;
        border: 0.2cqw solid var(--line);
        background: var(--chip);
    }

    .card i {
        display: block;
        font-style: normal;
        font-size: 4.6cqw;
    }

    .card b {
        display: block;
        font-size: 2.3cqw;
        margin: 0.4cqw 0;
    }

    .card span {
        font-size: 1.65cqw;
        color: var(--muted);
    }
</style>
