    .flinks a{color:var(--teal);text-decoration:none;border-bottom:2px solid transparent}
    .flinks a:hover{border-color:var(--teal)}

    .term{background:var(--navy-deep);border:1px solid rgba(255,255,255,.1);border-radius:16px;box-shadow:0 30px 60px -20px rgba(20,33,61,.45);overflow:hidden}
