<template>
    <section id="framework" aria-labelledby="fw-title">
        <div class="wrap">
            <div class="head rv">
                <div class="kicker">Frameworks</div>
                <h2 id="fw-title">Alo and Adhar, two small frameworks that fit together.</h2>
                <p class="sub">One builds the static site, the other the JSON API behind it. Both are plain files in folders, with zero dependencies, and they can live in one project.</p>
            </div>

            <div class="framework">
                <div class="rv">
                    <h3 class="fw-name">Alo, a small static site framework.</h3>
                    <p class="sub">Write plain HTML, CSS and JS in <code>.alo</code> files and get components, layouts, loops and conditions at build time. The result is a fully static site, with no config file, no imports and no runtime in the browser.</p>
                    <div class="chips">
                        <span class="chip hl">Zero dependencies</span>
                        <span class="chip">Node.js 22+</span>
                        <span class="chip">Static output</span>
                    </div>
                    <Command command="npx @msilabs/alo init my-site" label="Copy Alo npx command" />
                    <p class="hint">Add <code>--template docs</code> to start from a ready site, or pick <code>portfolio</code>, <code>landing</code> or <code>blank</code>.</p>
                    <div class="flinks">
                        <a href="https://msilabs.github.io/alo/" target="_blank" rel="noopener">Docs</a>
                        <a href="https://github.com/msilabs/alo" target="_blank" rel="noopener">GitHub</a>
                        <a href="https://www.npmjs.com/package/@msilabs/alo" target="_blank" rel="noopener">npm</a>
                    </div>
                </div>

                <div class="term rv" aria-hidden="true">
                    <div class="term-bar"><i></i><i></i><i></i><span>my-site</span></div>
                    <div class="term-body">
                        <span class="c"># folders are routes, files are components</span><br>
                        pages/page.alo <span class="c">→ /</span><br>
                        pages/about/page.alo <span class="c">→ /about/</span><br>
                        components/Card.alo <span class="c">→</span> <span class="s">&lt;Card /&gt;</span><br>
                        data/team.json <span class="c">→ data.team</span><br>
                        <span class="p">$</span> node alo build
                    </div>
                </div>
            </div>

            <div class="framework rev">
                <div class="rv">
                    <h3 class="fw-name">Adhar, a small backend API framework.</h3>
                    <p class="sub">Write plain JS functions in folders and get a JSON API: routing, middleware, validation, services and a built-in SQLite database. Add an Alo site in a <code>web/</code> folder and both run on one port, in one project.</p>
                    <div class="chips">
                        <span class="chip hl">Zero dependencies</span>
                        <span class="chip">Node.js 22.13+</span>
                        <span class="chip">SQLite built in</span>
                    </div>
                    <Command command="npx @msilabs/adhar init my-api" label="Copy Adhar npx command" />
                    <p class="hint">Add <code>--web</code> to start with an Alo site in the same project.</p>
                    <div class="flinks">
                        <a href="https://msilabs.github.io/adhar/" target="_blank" rel="noopener">Docs</a>
                        <a href="https://github.com/msilabs/adhar" target="_blank" rel="noopener">GitHub</a>
                        <a href="https://www.npmjs.com/package/@msilabs/adhar" target="_blank" rel="noopener">npm</a>
                    </div>
                </div>

                <div class="term rv" aria-hidden="true">
                    <div class="term-bar"><i></i><i></i><i></i><span>my-api</span></div>
                    <div class="term-body">
                        <span class="c"># folders are URLs, functions are handlers</span><br>
                        api/route.js <span class="c">→ /api</span><br>
                        api/notes/route.js <span class="c">→ /api/notes</span><br>
                        api/notes/[id]/route.js <span class="c">→ /api/notes/:id</span><br>
                        services/notes.js <span class="c">→ ctx.services.notes</span><br>
                        <span class="p">$</span> node adhar dev
                    </div>
                </div>
            </div>

            <div class="vsc rv">
                <div class="vsc-text">
                    <div class="vsc-top">
                        <span class="vsc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m8 10 3 2-3 2M13 15h3"/></svg></span>
                        <span class="vsc-kicker">VS Code extension</span>
                    </div>
                    <h3 class="vsc-name">Alo and Adhar, right in the editor.</h3>
                    <p>Syntax highlighting for <code>.alo</code> files, suggestions for components, props and <code>data</code>, Alo's own errors with quick fixes, and a dev server one click away.</p>
                </div>
                <div class="vsc-side">
                    <Command command="code --install-extension msilabs.alo-vscode" label="Copy VS Code install command" />
                    <div class="flinks">
                        <a href="{{ data.site.links.vscode }}" target="_blank" rel="noopener">Marketplace</a>
                        <a href="https://github.com/msilabs/alo-vscode" target="_blank" rel="noopener">GitHub</a>
                    </div>
                </div>
            </div>

            <p class="built rv">
                <span>Built with Alo:</span>
                <a href="/">this site</a>
                <a href="https://msilabs.github.io/project-health-dashboard/" target="_blank" rel="noopener">Project Health</a>
                <a href="{{ data.site.links.aloDocs }}" target="_blank" rel="noopener">Alo docs</a>
                <a href="https://msilabs.github.io/adhar/" target="_blank" rel="noopener">Adhar docs</a>
            </p>
        </div>
    </section>
</template>

<style>
    .framework{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
    .framework + .framework{margin-top:72px}
    .framework.rev{grid-template-columns:.9fr 1.1fr}
    .framework.rev .term{order:-1}
    .framework code{font-family:var(--mono);font-size:.92em}
    .fw-name{font-size:clamp(24px,3vw,32px);line-height:1.15;letter-spacing:-.02em;font-weight:800;margin:0 0 14px}
    .framework .chips{margin-top:24px}
    .hint{margin-top:12px;font-size:14.5px;color:var(--slate)}
    .flinks{display:flex;gap:18px;margin-top:20px;font-size:15px;font-weight:600}
    .flinks a{color:var(--teal);text-decoration:none;border-bottom:2px solid transparent}
    .flinks a:hover{border-color:var(--teal)}

    .term{background:var(--navy-deep);border:1px solid rgba(255,255,255,.1);border-radius:16px;box-shadow:0 30px 60px -20px rgba(20,33,61,.45);overflow:hidden}
    .term-bar{display:flex;align-items:center;gap:7px;padding:13px 16px;border-bottom:1px solid rgba(255,255,255,.07)}
    .term-bar i{width:11px;height:11px;border-radius:50%;background:#2B3E60;display:block}
    .term-bar i:first-child{background:var(--sun)}
    .term-bar span{margin-left:10px;font:400 13px var(--mono);color:#7F8DAA}
    .term-body{padding:22px 22px 26px;font:400 14.5px/2 var(--mono);color:#C8D2E6;overflow-x:auto;white-space:nowrap}
    .term-body .c{color:#6F7F9C}
    .term-body .p{color:var(--mint)}
    .term-body .s{color:#FFD58A}

    .vsc{margin-top:80px;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding:36px 40px;border-radius:20px;background:var(--navy);color:#fff}
    .vsc-top{display:flex;align-items:center;gap:12px;margin-bottom:16px}
    .vsc-ic{width:40px;height:40px;border-radius:11px;background:rgba(30,214,168,.16);color:var(--mint);display:grid;place-items:center}
    .vsc-ic svg{width:22px;height:22px}
    .vsc-kicker{font:600 13px/1 var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--mint)}
    .vsc-name{font-size:clamp(22px,2.6vw,28px);line-height:1.2;letter-spacing:-.02em;font-weight:800;margin:0 0 10px}
    .vsc p{color:#B8C4DC;font-size:16.5px}
    .vsc code{font-family:var(--mono);font-size:.9em;color:#FFD58A}
    .vsc .flinks a{color:var(--mint)}
    .vsc .flinks a:hover{border-color:var(--mint)}

    .built{display:flex;flex-wrap:wrap;gap:8px 18px;justify-content:center;margin-top:36px;font-size:15px;color:var(--slate)}
    .built span{font-weight:600;color:var(--navy)}
    .built a{color:var(--teal);font-weight:600;text-decoration:none;border-bottom:2px solid transparent}
    .built a:hover{border-color:var(--teal)}

    @media (max-width:960px){
        .vsc{grid-template-columns:1fr;gap:24px;padding:28px 24px;margin-top:64px}
        .framework,.framework.rev{grid-template-columns:1fr;gap:44px}
        .framework.rev .term{order:0}
        .framework + .framework{margin-top:56px}
    }
</style>

<style global>
    .vsc .cmd{background:var(--navy-deep);border:1px solid rgba(255,255,255,.08)}
</style>
