    .framework.rev .term{order:-1}
    .framework code{font-family:var(--mono);font-size:.92em}
    .fw-name{font-size:clamp(24px,3vw,32px);line-height:1.15;letter-spacing:-.02em;font-weight:800;margin:0 0 14px}
