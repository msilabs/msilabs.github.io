<template>
    <section id="story" aria-labelledby="story-title">
        <div class="wrap">
            <div class="head rv">
                <div class="kicker">Story</div>
                <h2 id="story-title">Small steps, shipped in public.</h2>
            </div>
            <ol class="tl" style="list-style:none">
                <template for="step in data.story">
                    <li class="step {{ step.now ? 'now' : null }} rv">
                        <time datetime="{{ step.datetime }}">{{ step.label }}</time>
                        <h3>{{ step.title }}</h3>
                        <p>
                            <template if="step.code">
                                <code style="font-family:var(--mono);font-size:.92em">{{ step.code }}</code>
                            </template>
                            {{ step.text }}
                        </p>
                    </li>
                </template>
            </ol>
        </div>
    </section>
</template>

<style>
    .tl{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:8px}
    .tl::before{content:"";position:absolute;left:0;right:0;top:11px;height:2px;background:var(--line)}
    .step{position:relative;padding-top:42px}
    .step::before{content:"";position:absolute;left:0;top:2px;width:20px;height:20px;border-radius:50%;background:#fff;border:4px solid var(--mint)}
    .step.now::before{border-color:var(--sun);box-shadow:0 0 0 6px rgba(255,176,32,.18)}
    .step time{font:600 13px var(--mono);letter-spacing:.05em;color:var(--teal);text-transform:uppercase}
    .step h3{font-size:18px;margin:8px 0 6px;letter-spacing:-.01em}
    .step p{font-size:15px;color:var(--slate)}

    @media (max-width:960px){
        .tl{grid-template-columns:1fr 1fr;row-gap:34px}
        .tl::before{display:none}
    }
    @media (max-width:640px){
        .tl{grid-template-columns:1fr}
    }
</style>
