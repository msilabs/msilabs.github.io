<template>
    <div class="lesson">
        <template for="course in data.courses.filter((c) => c.id === props.course)">
            <template for="i in [course.lessons.findIndex((l) => l.slug === props.slug)]">
                <section class="body">
                    <div class="wrap">
                        <nav class="crumbs" aria-label="Breadcrumb">
                            <a href="/learn/">শিখুন</a>
                            <span aria-hidden="true">/</span>
                            <a href="/learn/{{ course.id }}/">{{ course.title }}</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">{{ course.lessons[i].title }}</span>
                        </nav>
                        <h1>{{ course.lessons[i].title }}</h1>
                        <p class="lead">{{ course.lessons[i].description }}</p>

                        <slot />

                        <p class="tip">পর্দায় ক্লিক করলে বা Space চাপলে চলবে আর থামবে। পর্দার লেখা সিলেক্ট করে কপিও করা যায়।</p>

                        <Learn.Script captions="{{ data.timelines.find((t) => t.slug === props.slug).captions }}" />

                        <nav class="pager" aria-label="পাঠ">
                            <template if="i > 0">
                                <a class="prev" href="/learn/{{ course.id }}/{{ course.lessons[i - 1].slug }}/">
                                    <span>← আগের পাঠ</span>
                                    <b>{{ course.lessons[i - 1].title }}</b>
                                </a>
                            </template>
                            <template else>
                                <a class="prev" href="/learn/{{ course.id }}/">
                                    <span>← course</span>
                                    <b>{{ course.title }}</b>
                                </a>
                            </template>
                            <template if="course.lessons[i + 1] && course.lessons[i + 1].status !== 'soon'">
                                <a class="next" href="/learn/{{ course.id }}/{{ course.lessons[i + 1].slug }}/">
                                    <span>পরের পাঠ →</span>
                                    <b>{{ course.lessons[i + 1].title }}</b>
                                </a>
                            </template>
                            <template else-if="course.lessons[i + 1]">
                                <div class="next off">
                                    <span>পরের পাঠ · শীঘ্রই</span>
                                    <b>{{ course.lessons[i + 1].title }}</b>
                                </div>
                            </template>
                            <template else>
                                <a class="next" href="/learn/">
                                    <span>আরও শিখুন →</span>
                                    <b>সব পাঠ আর simulator</b>
                                </a>
                            </template>
                        </nav>
                    </div>
                </section>
            </template>
        </template>
    </div>
</template>

<style>
    .body{padding:40px 0 80px;background:var(--cloud)}
    .wrap{max-width:1000px}
    .crumbs{display:flex;flex-wrap:wrap;gap:8px;font-size:14.5px;color:var(--slate);margin-bottom:20px}
    .crumbs a{color:var(--teal);text-decoration:none}
    .crumbs a:hover{text-decoration:underline}
    h1{font-size:clamp(28px,4.4vw,42px);line-height:1.25;font-weight:700;margin-bottom:10px}
    .lead{color:var(--slate);font-size:17px;max-width:720px;margin-bottom:28px}
    .tip{margin-top:14px;font-size:14.5px;color:var(--slate)}
    .pager{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:36px}
    .pager a,.pager div{display:flex;flex-direction:column;gap:4px;padding:18px 20px;border:1px solid var(--line);border-radius:14px;background:#fff;text-decoration:none;color:inherit}
    .pager a:hover{border-color:var(--teal)}
    .pager .next{text-align:right;grid-column:2}
    .pager .off{opacity:.65}
    .pager span{font-size:14px;color:var(--teal);font-weight:600}
    .pager b{font-size:16.5px}

    @media (max-width:640px){
        .pager{grid-template-columns:1fr}
        .pager .next{grid-column:auto;text-align:left}
    }
</style>
