<template>
    <a class="ccard rv" href="/learn/{{ props.course.id }}/" data-topic="{{ props.course.topic }}">
        <Learn.Cover
            color="{{ props.course.color }}"
            icon="{{ props.course.icon }}"
            soon="{{ props.course.status === 'soon' }}"
            label="{{ props.course.lessons.length ? String(props.course.lessons.length).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[d]) + 'টা পাঠ' : null }}"
        />
        <div class="body">
            <span class="topic">{{ props.course.topic }}</span>
            <h3>{{ props.course.title }}</h3>
            <p>{{ props.course.description }}</p>
        </div>
    </a>
</template>

<style>
    .ccard{display:flex;flex-direction:column;gap:16px;text-decoration:none;color:inherit;padding:12px 12px 20px;border:1px solid var(--line);border-radius:20px;background:#fff;transition:box-shadow .2s,transform .2s}
    .ccard:hover{box-shadow:0 24px 48px -28px rgba(20,33,61,.35);transform:translateY(-2px)}
    .body{padding:0 8px}
    .topic{font:600 12px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--teal)}
    h3{font-size:21px;line-height:1.35;margin:10px 0 6px}
    p{color:var(--slate);font-size:15.5px}

    @media (prefers-reduced-motion:reduce){
        .ccard{transition:none}
    }
</style>
