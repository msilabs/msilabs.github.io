<template>
    <div class="cover {{ props.color }} {{ props.class }}">
        <template if="props.thumb">
            <img src="{{ props.thumb }}" alt="" loading="lazy">
        </template>
        <template else>
            <span class="icon" aria-hidden="true">{{ props.icon }}</span>
        </template>
        <template if="props.soon">
            <span class="soon">শীঘ্রই</span>
        </template>
        <template else-if="props.open">
            <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 16 16 8M9 8h7v7"/></svg></span>
        </template>
        <template else>
            <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
        </template>
        <template if="props.label">
            <span class="label">{{ props.label }}</span>
        </template>
    </div>
</template>

<style>
    .cover{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;display:grid;place-items:center;background:linear-gradient(135deg,var(--c1),var(--c2));color:#fff;container-type:inline-size}
    .cover.mint{--c1:#14213D;--c2:#0B7F6E}
    .cover.coral{--c1:#14213D;--c2:#C2412D}
    .cover.sun{--c1:#1B2B4D;--c2:#B7791F}
    .cover.indigo{--c1:#14213D;--c2:#4F46E5}
    .cover::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(255,255,255,.18),transparent 55%);pointer-events:none}
    .cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .icon{font-size:clamp(28px,22cqw,72px);line-height:1;filter:drop-shadow(0 6px 14px rgba(0,0,0,.25))}
    .play{position:absolute;left:12px;bottom:12px;width:clamp(30px,13cqw,44px);height:clamp(30px,13cqw,44px);border-radius:50%;background:rgba(255,255,255,.92);color:var(--navy);display:grid;place-items:center;z-index:1}
    .play svg{width:55%;height:55%}
    .soon{position:absolute;left:12px;bottom:12px;font-size:13px;font-weight:600;padding:5px 11px;border-radius:999px;background:var(--sun);color:var(--navy);z-index:1}
    .label{position:absolute;right:12px;bottom:12px;font:600 12.5px/1 var(--mono);padding:6px 9px;border-radius:7px;background:rgba(14,24,45,.75);color:#fff;z-index:1}
</style>
