<template>
    <section id="learn" class="dark" aria-labelledby="learn-title">
        <div class="wrap">
            <div class="top rv">
                <div>
                    <div class="kicker">Learn</div>
                    <h2 id="learn-title">Learn by doing, right in the browser.</h2>
                    <p class="sub">Simulators and games that explain developer ideas in Bangla. For animated lessons, visit <span lang="bn">msilabs শিখুন</span>.</p>
                </div>
                <a class="btn btn-mint" href="/learn/">Lessons in Bangla →</a>
            </div>

            <div class="cards">
                <template for="item in data.interactive">
                    <article class="card {{ item.color }} rv">
                        <div class="art" aria-hidden="true">
                            <span class="icon">{{ item.icon }}</span>
                            <span class="meta" lang="bn">{{ item.meta }}</span>
                        </div>
                        <span class="tag">Interactive · <span lang="bn">{{ item.topic }}</span></span>
                        <h3 lang="bn"><a href="{{ item.href }}" target="_blank" rel="noopener">{{ item.name }}</a></h3>
                        <p lang="bn">{{ item.description }}</p>
                        <div class="links">
                            <a class="open" href="{{ item.href }}" target="_blank" rel="noopener">Open ↗</a>
                            <a href="{{ item.github }}" target="_blank" rel="noopener">GitHub</a>
                        </div>
                    </article>
                </template>
            </div>
        </div>
    </section>
</template>

<style>
    .top{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:44px}
    .top .btn{flex:none}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .card{display:flex;flex-direction:column;padding:12px 12px 22px;border-radius:20px;background:var(--navy-soft);border:1px solid rgba(255,255,255,.08);transition:border-color .2s,transform .2s}
    .card:hover{border-color:rgba(30,214,168,.5);transform:translateY(-2px)}
    .card.mint{--c:#0B7F6E}
    .card.sun{--c:#B7791F}
    .card.indigo{--c:#4F46E5}
    .art{position:relative;aspect-ratio:16/9;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#14213D,var(--c));overflow:hidden}
    .art::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(255,255,255,.18),transparent 55%)}
    .icon{font-size:64px;line-height:1;filter:drop-shadow(0 6px 14px rgba(0,0,0,.25))}
    .meta{position:absolute;right:12px;bottom:12px;font:600 12.5px/1 var(--sans-bn);padding:6px 9px;border-radius:7px;background:rgba(14,24,45,.75);color:#fff;z-index:1}
    .tag{margin:18px 8px 0;font:600 12px/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--mint)}
    .tag span{font-family:var(--sans-bn);letter-spacing:0}
    h3{margin:8px 8px 6px;font-size:21px;line-height:1.35}
    h3 a{color:#fff;text-decoration:none}
    h3 a:hover{color:var(--mint)}
    .card p{margin:0 8px 18px;color:#B8C4DC;font-size:15.5px}
    .links{display:flex;gap:18px;margin:auto 8px 0;font-size:15px;font-weight:600}
    .links a{color:#C8D2E6;text-decoration:none}
    .links a.open{color:var(--mint)}
    .links a:hover{text-decoration:underline}

    @media (max-width:960px){
        .top{flex-direction:column;align-items:flex-start}
        .cards{grid-template-columns:1fr}
    }
    @media (prefers-reduced-motion:reduce){
        .card{transition:none}
    }
</style>
