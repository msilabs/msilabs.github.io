<template>
    <section id="learn" class="dark" aria-labelledby="learn-title">
        <div class="wrap">
            <div class="top rv">
                <div>
                    <div class="kicker">Learn</div>
                    <h2 id="learn-title">Lessons in Bangla, made to be watched.</h2>
                    <p class="sub">Short animated lessons that are plain HTML, not video: select the text, change the speed, read the full script. Plus simulators you can play with in the browser.</p>
                </div>
                <a class="btn btn-mint" href="/learn/">See all lessons →</a>
            </div>

            <div class="cards">
                <template for="latest in data.courses.flatMap((c) => c.lessons.filter((l) => l.status !== 'soon').map((l) => ({ lesson: l, course: c }))).slice(-1)">
                    <a class="card rv" href="/learn/{{ latest.course.id }}/{{ latest.lesson.slug }}/" lang="bn">
                        <Learn.Cover color="{{ latest.course.color }}" icon="{{ latest.course.icon }}" thumb="{{ latest.lesson.thumb }}" label="{{ latest.lesson.duration }}" />
                        <span class="tag new">নতুন পাঠ · {{ latest.course.title }}</span>
                        <h3>{{ latest.lesson.title }}</h3>
                        <p>{{ latest.lesson.description }}</p>
                    </a>
                </template>

                <div class="card rv" lang="bn">
                    <Learn.Cover color="indigo" icon="🧪" label="{{ String(data.interactive.length).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[d]) }}টা simulator" open />
                    <span class="tag">Interactive</span>
                    <h3>নিজের হাতে করে দেখুন</h3>
                    <ul>
                        <template for="item in data.interactive">
                            <li><a href="{{ item.href }}" target="_blank" rel="noopener">{{ item.name }}</a> <span>{{ item.meta }}</span></li>
                        </template>
                    </ul>
                </div>

                <template for="course in data.courses.filter((c) => c.status === 'soon')">
                    <a class="card rv" href="/learn/{{ course.id }}/" lang="bn">
                        <Learn.Cover color="{{ course.color }}" icon="{{ course.icon }}" soon />
                        <span class="tag soon">সিরিজ · শীঘ্রই</span>
                        <h3>{{ course.title }}</h3>
                        <p>{{ course.description }}</p>
                    </a>
                </template>
            </div>
        </div>
    </section>
</template>

<style>
    .top{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:44px}
    .top .btn{flex:none}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .card{display:flex;flex-direction:column;padding:12px 12px 22px;border-radius:20px;background:var(--navy-soft);border:1px solid rgba(255,255,255,.08);color:#fff;text-decoration:none;transition:border-color .2s,transform .2s}
    a.card:hover{border-color:rgba(30,214,168,.5);transform:translateY(-2px)}
    .tag{margin:18px 8px 0;font-size:13px;font-weight:600;color:var(--mint)}
    .tag.soon{color:var(--sun)}
    .card h3{margin:8px 8px 6px;font-size:21px;line-height:1.35}
    .card p{margin:0 8px;color:#B8C4DC;font-size:15.5px}
    .card ul{list-style:none;margin:6px 8px 0;display:grid;gap:8px}
    li{display:flex;justify-content:space-between;gap:12px;font-size:15.5px;border-bottom:1px solid rgba(255,255,255,.08);padding-bottom:8px}
    li:last-child{border-bottom:0;padding-bottom:0}
    li a{color:#fff;font-weight:600;text-decoration:none}
    li a:hover{color:var(--mint)}
    li span{color:#8E9CBA;font-size:14px}

    @media (max-width:960px){
        .top{flex-direction:column;align-items:flex-start}
        .cards{grid-template-columns:1fr}
    }
    @media (prefers-reduced-motion:reduce){
        .card{transition:none}
    }
</style>
