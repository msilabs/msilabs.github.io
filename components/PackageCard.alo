<template>
    <article class="pkg {{ props.pkg.accent }} rv">
        <span class="tag"><i></i> {{ props.pkg.tag }}</span>
        <h3>{{ props.pkg.name }}</h3>
        <p class="d">{{ props.pkg.description }}</p>
        <ul>
            <template for="feature in props.pkg.features">
                <li>{{ feature }}</li>
            </template>
        </ul>
        <div class="chips">
            <template for="chip in props.pkg.chips">
                <span class="chip {{ chip.highlight ? 'hl' : null }}">{{ chip.text }}</span>
            </template>
        </div>
        <div class="cmd">
            <code><i>$ </i><span class="cmd-text">{{ props.pkg.command }}</span></code>
            <button class="copy" type="button" data-copy="{{ props.pkg.command }}" aria-label="{{ props.pkg.copyLabel }}">Copy</button>
        </div>
        <div class="plinks">
            <template for="link in props.pkg.links">
                <a href="{{ link.href }}" target="_blank" rel="noopener">{{ link.label }}</a>
            </template>
        </div>
    </article>
</template>

<style>
    .pkg{background:#fff;border:1px solid var(--line);border-radius:20px;padding:32px;display:flex;flex-direction:column;position:relative;overflow:hidden;transition:box-shadow .2s,transform .2s}
    .pkg:hover{box-shadow:0 24px 48px -28px rgba(20,33,61,.35);transform:translateY(-2px)}
    .pkg::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:var(--acc)}
    .pkg.laravel{--acc:#F05340}
    .pkg.node{--acc:#3C873A}
    .tag{display:inline-flex;align-items:center;gap:8px;font:500 12.5px/1 var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--slate)}
    .tag i{width:9px;height:9px;border-radius:50%;background:var(--acc);display:block}
    .pkg h3{font:600 26px/1.2 var(--mono);letter-spacing:-.02em;margin:16px 0 12px;word-break:break-word}
    .pkg p.d{color:var(--slate);font-size:16.5px}
    .pkg ul{list-style:none;margin:20px 0 22px;display:grid;gap:10px}
    .pkg li{position:relative;padding-left:26px;font-size:15.5px}
    .pkg li::before{content:"";position:absolute;left:2px;top:.5em;width:12px;height:7px;border-left:2.5px solid var(--teal);border-bottom:2.5px solid var(--teal);transform:rotate(-45deg) translateY(-3px)}
    .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
    .chip{font-size:13.5px;font-weight:500;padding:6px 12px;border-radius:999px;background:var(--cloud);border:1px solid var(--line);color:var(--slate)}
    .chip.hl{background:rgba(30,214,168,.12);border-color:rgba(11,127,110,.3);color:var(--teal);font-weight:600}
    .cmd{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--navy);border-radius:12px;padding:6px 6px 6px 16px;margin-top:auto}
    .cmd code{font:400 14px var(--mono);color:#FFD58A;overflow-x:auto;white-space:nowrap;padding:8px 0}
    .cmd code i{font-style:normal;color:#6F7F9C}
    .copy{flex:none;font:600 13px var(--sans);background:rgba(255,255,255,.1);color:#fff;border:0;padding:10px 14px;border-radius:9px;cursor:pointer;transition:background .15s}
    .copy:hover{background:rgba(255,255,255,.18)}
    .copy.ok{background:var(--mint);color:var(--navy)}
    .plinks{display:flex;gap:18px;margin-top:20px;font-size:15px;font-weight:600}
    .plinks a{color:var(--teal);text-decoration:none;border-bottom:2px solid transparent}
    .plinks a:hover{border-color:var(--teal)}

    @media (max-width:640px){
        .pkg{padding:26px 22px}
        .cmd code{white-space:normal;word-break:break-all;line-height:1.5;padding:10px 0}
    }
    @media (prefers-reduced-motion:reduce){
        .pkg{transition:none}
    }
</style>

<script>
    const button = $el.querySelector('.copy');

    function fallbackCopy(text) {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try {
            document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(area);
    }

    function showCopied() {
        button.textContent = 'Copied';
        button.classList.add('ok');
        setTimeout(() => {
            button.textContent = 'Copy';
            button.classList.remove('ok');
        }, 1600);
    }

    button.addEventListener('click', () => {
        const text = button.getAttribute('data-copy');
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(showCopied, () => {
                fallbackCopy(text);
                showCopied();
            });
        } else {
            fallbackCopy(text);
            showCopied();
        }
    });
</script>
