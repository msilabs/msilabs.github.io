<head>
    <title>শিখুন | msilabs</title>
    <meta name="description" content="বাংলায় ছোট ছোট animated পাঠ আর interactive simulator: ওয়েব কীভাবে চলে, Git, scaling আর Laravel।">
    <link rel="canonical" href="{{ data.site.url }}/learn/">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ data.site.url }}/learn/">
    <meta property="og:title" content="শিখুন | msilabs">
    <meta property="og:description" content="বাংলায় ছোট ছোট animated পাঠ আর interactive simulator।">
    <meta property="og:image" content="{{ data.site.url }}/og.png">
    <meta name="twitter:card" content="summary_large_image">
</head>

<template>
    <section class="dark top">
        <div class="wrap">
            <div class="kicker">Learn</div>
            <h1>দেখে, শুনে আর হাতে-কলমে শিখুন।</h1>
            <p class="sub">বাংলায় ছোট ছোট animated পাঠ। প্রতিটা পাঠ সাধারণ HTML, ভিডিও নয়: লেখা সিলেক্ট করা যায়, গতি বদলানো যায়, আর পুরো স্ক্রিপ্ট নিচেই থাকে।</p>
            <div class="filters" role="group" aria-label="বিষয় অনুযায়ী ফিল্টার">
                <button type="button" class="fchip on" data-filter="" aria-pressed="true">সব</button>
                <template for="topic in [...new Set([...data.courses, ...data.interactive].map((x) => x.topic))]">
                    <button type="button" class="fchip" data-filter="{{ topic }}" aria-pressed="false">{{ topic }}</button>
                </template>
            </div>
        </div>
    </section>

    <section class="group" data-group>
        <div class="wrap">
            <h2>Course</h2>
            <div class="grid">
                <template for="course in data.courses">
                    <Learn.CourseCard course="{{ course }}" />
                </template>
            </div>
        </div>
    </section>

    <section class="group tint" data-group>
        <div class="wrap">
            <h2>Interactive</h2>
            <p class="lead">ব্রাউজারেই চলে এমন simulator আর খেলা। পড়ার চেয়ে নিজে করে দেখা অনেক সময় বেশি কাজে দেয়।</p>
            <div class="grid">
                <template for="item in data.interactive">
                    <Learn.Interactive item="{{ item }}" />
                </template>
            </div>
        </div>
    </section>
</template>

<style>
    .top{padding:64px 0 56px}
    h1{font-size:clamp(32px,5vw,52px);line-height:1.2;font-weight:700;margin:14px 0 16px}
    .filters{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px}
    .fchip{font:500 14.5px/1 var(--sans-bn);padding:10px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.2);background:transparent;color:#C8D2E6;cursor:pointer;transition:background .15s,color .15s,border-color .15s}
    .fchip:hover{border-color:rgba(255,255,255,.5);color:#fff}
    .fchip.on{background:var(--mint);border-color:var(--mint);color:var(--navy);font-weight:600}
    .group{padding:64px 0}
    .group h2{font-size:clamp(26px,3.4vw,34px);font-weight:700;margin:0 0 10px}
    .lead{color:var(--slate);max-width:640px}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:28px}

    @media (max-width:960px){
        .grid{grid-template-columns:1fr 1fr}
    }
    @media (max-width:640px){
        .grid{grid-template-columns:1fr}
    }
</style>

<script>
    const chips = document.querySelectorAll('.fchip');
    const groups = document.querySelectorAll('[data-group]');

    function applyFilter(topic) {
        chips.forEach((chip) => {
            const active = chip.dataset.filter === topic;
            chip.classList.toggle('on', active);
            chip.setAttribute('aria-pressed', String(active));
        });
        groups.forEach((group) => {
            let visible = 0;
            group.querySelectorAll('[data-topic]').forEach((card) => {
                const show = !topic || card.dataset.topic === topic;
                card.hidden = !show;
                if (show) visible++;
            });
            group.hidden = visible === 0;
        });
    }

    chips.forEach((chip) => {
        chip.addEventListener('click', () => applyFilter(chip.dataset.filter));
    });
</script>
